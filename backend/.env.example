# SatQuery AI - Backend Environment Configuration
#
# NOTE: All service endpoints, API keys, and model connection settings are authoritatively
# configured in: backend/config/model_endpoints.yaml
# To connect an external GeoChat instance (e.g. HuggingFace, RunPod, or local Gradio),
# simply edit 'services.geochat-7b.base_url' in backend/config/model_endpoints.yaml.

APP_ENV=development
APP_NAME="SatQuery AI Backend"
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model Timeout in seconds
MODEL_TIMEOUT=180

# When true, explicitly allows mock test mode when requested by test suites.
# In live production inference, missing models return clean NOT_CONFIGURED status.
ENABLE_MOCK_FALLBACK_FOR_TESTS=false

# Specialist Model 1: GeoChat-7B (VLM for Single Image VQA / Grounding / Captioning)
GEOCHAT_API_URL=
GEOCHAT_API_TYPE=gradio
GEOCHAT_API_ENDPOINT=predict

# Specialist Model 2: ChangeStar / Bi-temporal Change Detection
CHANGE_MODEL_API_URL=
CHANGE_MODEL_API_TYPE=gradio
CHANGE_MODEL_API_ENDPOINT=predict

# Specialist Model 3: CROMA / Optical-SAR Multimodal Fusion
CROMA_API_URL=
CROMA_API_TYPE=gradio
CROMA_API_ENDPOINT=predict

# Specialist Model 4: Dedicated Visual Grounding Specialist
GROUNDING_API_URL=
GROUNDING_API_TYPE=gradio
GROUNDING_API_ENDPOINT=predict

# Database Configuration
DATABASE_URL=sqlite:///./satquery.db

# Experiment Logging & Caching
EXPERIMENT_LOGGING=true
CACHE_ENABLED=false

# Upload Storage Directory
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
